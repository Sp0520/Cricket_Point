# Copy this file to .env and set your database credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cricket_db
DB_USER=root
DB_PASS=secret

# Optional: override charset
DB_CHARSET=utf8mb4

# Optional app base path
APP_WEB_BASE=# Example Render environment variables for CricketPoints
# Use either DATABASE_URL or explicit DB_* variables.

# Option 1: Render database URL
# DATABASE_URL=mysql://user:password@hostname:3306/dbname

# Option 2: Explicit MySQL variables
# DB_HOST=hostname
# DB_NAME=dbname
# DB_USER=user
# DB_PASS=password
# DB_PORT=3306

# Optional:
# DB_CHARSET=utf8mb4
# APP_WEB_BASE=
